# Local/system state
clear/
.env
.env.*
!.env.example
*.credential.xml
*.pem
*.key
*.p12
*.pfx
runtime/
__pycache__/
*.py[cod]
db.sqlite3
.pytest_cache/
.venv/
node_modules/
dist/
coverage/
*.log
.tmp-*
.DS_Store
Thumbs.db

# Runtime data
media/
backups/
postgres-data/
secrets/*
!secrets/.gitkeep
artifacts/**/.venv/
.opencode/

# Built from pinned upstream archives and SHA256-verified inside Docker.
/backend/font-assets/*.ttf

/backend/.offline-wheels/*
!/backend/.offline-wheels/.gitkeep

# Temporary QA, release staging and private installation materials.
/testTemp/*
!/testTemp/README.md
/resources/private/
