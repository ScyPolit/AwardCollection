APP_PORT=18080
APP_TLS_PORT=18443
APP_PUBLIC_HOST=localhost
POSTGRES_DB=awardcollection
POSTGRES_USER=awardcollection
POSTGRES_PASSWORD=replace-with-the-same-random-value-as-secrets-db-password
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:18443,https://127.0.0.1:18443
SIGNING_MASTER_KEY=replace-with-base64-encoded-32-byte-key
SIGNING_KEY_PASSWORD=replace-with-a-separate-random-signing-key-password
CERTIFICATE_FONT=/srv/media/fonts/wqy-zenhei.ttc
RENDER_CONCURRENCY=1
INITIAL_ADMIN_PASSWORD=replace-with-random-password
APP_BUILD_VERSION=development
APP_SOURCE_DIR=.
